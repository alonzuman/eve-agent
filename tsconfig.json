{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "eve/workflow-modules"],
    "allowImportingTsExtensions": true
  },
  "include": ["agent/**/*.ts", "src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "evals/**/*.ts", "drizzle.config.ts"]
}
