# Provisioned by `vercel blob create-store ... --access private --yes`.
# Pull actual values securely with `vercel env pull .env.local --yes`.
BLOB_READ_WRITE_TOKEN=

# Existing Linq account; enter these in Vercel, never in source control/chat.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=

# Kernel uses the attached Vercel Connect connector kernel/eve-kernel.
# Each sender authorizes Kernel through the link the agent supplies on first use.
# No shared KERNEL_API_KEY or Chromium snapshot is required.

# Model/Sandbox authentication is automatic through Vercel project OIDC.
# `vercel env pull .env.local --yes` supplies development OIDC.
# No Link wallet or payment credentials are required for this phase.
