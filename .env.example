# Provisioned by `vercel blob create-store ... --access private --yes`.
# Pull actual values securely with `vercel env pull .env.local --yes`.
BLOB_READ_WRITE_TOKEN=

# Neon / Postgres: pooled runtime connection and direct migration connection.
# Run `npm run db:migrate` against the intended database before deploying.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Existing Linq account; enter these in Vercel, never in source control/chat.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=

# App-owned Kernel Marketplace resource; users never authorize Kernel.
KERNEL_API_KEY=

# App-owned Exa Marketplace resource; kept server-side, never in the sandbox.
EXA_API_KEY=

# Comma-separated E.164 sender numbers, e.g. +12025550101,+12025550102.
# Missing, empty, or malformed values block responses. Redeploy after changes.
LINQ_ALLOWED_NUMBERS=

# Model/Sandbox authentication is automatic through Vercel project OIDC.
# `vercel env pull .env.local --yes` supplies development OIDC.

# Per-user Link connections: generate 32 random bytes encoded as 64 hex characters.
# Keep this stable and secret in each environment; changing it requires re-encrypting
# existing wallet records. Never put a personal LINK_ACCESS_TOKEN in the app env.
# Set this and run db:migrate to enable connect/status/disconnect (no live purchases).
LINK_WALLET_ENCRYPTION_KEY=
