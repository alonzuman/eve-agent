# Provisioned by `vercel blob create-store ... --access private --yes`.
# Pull actual values securely with `vercel env pull .env.local --yes`.
BLOB_READ_WRITE_TOKEN=

# Existing Linq account; enter these in Vercel, never in source control/chat.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=

# App-owned Kernel Marketplace resource; users never authorize Kernel.
KERNEL_API_KEY=

# Vercel Flags server SDK key for this environment (automatically provisioned
# when creating the first flag). Create the boolean flag linq-responses with
# fallback=false and add allowed E.164 sender numbers as User ID targets for true.
# Paused/missing/invalid/unavailable flags mean no responses.
FLAGS=

# Model/Sandbox authentication is automatic through Vercel project OIDC.
# `vercel env pull .env.local --yes` supplies development OIDC.
# No Link wallet or payment credentials are required for this phase.
